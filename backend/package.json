{
  "name": "dronehub-backend",
  "version": "1.0.0",
  "description": "Backend API for DRONEHUB - Multi-Tenant Drone Rental & Tracking Management System",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed:users": "node seeders/seedDemoUsers.js",
    "seed:drones": "node seeders/seedDrones.js",
    "seed:bookings": "node seeders/seedBookings.js",
    "seed:all": "node seeders/seedDemoUsers.js && node seeders/seedDrones.js && node seeders/seedBookings.js"
  },
  "keywords": [
    "dronehub",
    "drone-rental",
    "tracking",
    "express",
    "mongodb",
    "mongoose"
  ],
  "author": "DRONEHUB Team",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-validator": "^7.2.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "multer": "^2.5.0",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.4.0",
    "nodemon": "^3.1.9"
  }
}
